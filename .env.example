# Copie para .env para sobrescrever os padrões do docker-compose.
# Todos os valores abaixo são apenas para desenvolvimento local.

# Profiles usados quando se roda `docker compose up` sem o Makefile
COMPOSE_PROFILES=core,observability

# Credenciais de desenvolvimento
POSTGRES_PASSWORD=dev-only-change-me
MINIO_ROOT_USER=dev-only-minio
MINIO_ROOT_PASSWORD=dev-only-change-me
S3_BUCKET=agrovale-telemetry-raw

# Faixas agronômicas (alertas e GET /thresholds); padrões em internal/telemetry
# THRESHOLD_TEMPERATURE_MIN=12
# THRESHOLD_TEMPERATURE_MAX=32
# THRESHOLD_HUMIDITY_MIN=50
# THRESHOLD_HUMIDITY_MAX=90
# THRESHOLD_CO2_MIN=350
# THRESHOLD_CO2_MAX=1500
# THRESHOLD_LUMINOSITY_MIN=0
# THRESHOLD_LUMINOSITY_MAX=80000

# Notificador de alertas (e-mail para o Mailpit; webhook assinado com HMAC-SHA256)
# O segredo de cada webhook é uma variável de ambiente nomeada em
# deploy/notifier/recipients.json (webhook_secret_env), com 16+ caracteres.
# NOTIFY_WEBHOOK_ALLOW_HTTP=false

# Perfil da carga do simulador
SIM_GREENHOUSES=20
SIM_RATE=80

# Tamanho da janela do agregador, escopo do watermark (greenhouse ou partition)
# e ociosidade que fecha janelas de uma estufa calada (0 desliga)
WINDOW_SIZE=1m
# WATERMARK_SCOPE=greenhouse
# WATERMARK_IDLE_TIMEOUT=2m

# Tracing: com o profile observability, use http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05

# Profile secure: o material (certificados, senhas, JAAS) é gerado por make
# secure-init em .secure/ e nunca versionado; nada dele vai neste arquivo.

# Portas do host, caso já estejam em uso
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
CONNECT_PORT=8083
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6380
SIMULATOR_METRICS_PORT=9101
AGGREGATOR_METRICS_PORT=9102
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318
KAFKA_UI_PORT=8080
MAILPIT_UI_PORT=8025
NOTIFIER_METRICS_PORT=9103
AGGREGATOR_SECURE_PORT=9112
