{
  "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
  "tasks.max": "1",
  "topics": "greenhouse.aggregates",
  "connection.url": "jdbc:postgresql://postgres:5432/telemetry",
  "connection.user": "${env:JDBC_SINK_USER}",
  "connection.password": "${env:JDBC_SINK_PASSWORD}",
  "table.name.format": "greenhouse_window_aggregates",
  "insert.mode": "upsert",
  "pk.mode": "record_value",
  "pk.fields": "greenhouse_id,sensor_type,window_start",
  "auto.create": "false",
  "auto.evolve": "false",
  "db.timezone": "UTC",
  "batch.size": "500",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://schema-registry:8081",
  "errors.tolerance": "all",
  "errors.log.enable": "true",
  "errors.deadletterqueue.topic.name": "greenhouse.aggregates.connect-dlq",
  "errors.deadletterqueue.topic.replication.factor": "1",
  "errors.deadletterqueue.context.headers.enable": "true"
}
